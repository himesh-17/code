GROQ_API_KEY=your-groq-key-here
LLM_PROVIDER=groq            # groq | openai | mock
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o
DATABASE_PATH=backend/brandguard.db

# Optional: set to 0 to block the inbound webhook from auto-approving or
# publishing without a human (the read-only "review" action stays allowed).
# INBOUND_ALLOW_AUTOPUBLISH=0

# Demo accounts + sample content on boot. Set to 0 for a clean production DB
# (no creator/reviewer/manager/admin@brandguard.demo accounts are created).
# SEED_DEMO=0

# Rate limits (per IP, per minute): AI reviews are expensive; auth is brute-force.
# REVIEW_RATE_PER_MIN=10
# AUTH_RATE_PER_MIN=60
